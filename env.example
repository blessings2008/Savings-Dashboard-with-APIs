# ================================
# SAVERPRO ENVIRONMENT VARIABLES
# Add these to Render → Environment
# ================================

# FIREBASE ADMIN SDK
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=money-saver-e0504
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@money-saver-e0504.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# FIREBASE CLIENT (for frontend)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=money-saver-e0504.firebaseapp.com
FIREBASE_STORAGE_BUCKET=money-saver-e0504.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=414713997121
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# AIRTEL API (add when approved)
AIRTEL_CLIENT_ID=your_client_id_here
AIRTEL_CLIENT_SECRET=your_client_secret_here
AIRTEL_PIN=your_airtel_pin_here

# REFERRAL POOL
# Set this to the existing Main Pool Firestore document ID before enabling
# Main Pool → Referral Pool transfers. Do not guess or reuse customer funds.
REFERRAL_MAIN_POOL_DOC=your-existing-main-pool-document-id

# SERVER
PORT=3000